{
  "name": "court-of-knives",
  "private": true,
  "version": "0.1.0",
  "description": "A medieval court-intrigue game of plots, secrets, lies and betrayal. No armies, no running about \u2014 only motives.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
