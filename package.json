{
  "name": "crown-of-whispers",
  "private": true,
  "version": "0.1.0",
  "productName": "Crown of Whispers",
  "description": "A medieval court-intrigue game of plots, secrets, lies and betrayal. No armies, no running about — only motives.",
  "author": "Usman Naeem",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/page.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "app": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans-sc": "5.3.0",
    "@fontsource/grenze-gotisch": "5.3.0",
    "@iconify-json/game-icons": "1.2.4",
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
